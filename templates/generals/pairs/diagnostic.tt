[% WRAPPER layouts/default.tt %]

<div class="diagnostic-container">
  <h1>Pairs Diagnostic: [% diagnostic.type %]</h1>

  <section class="stats">
    <h2>Statistics</h2>
    <table class="diagnostic-table">
      <tr>
        <th>Type</th>
        <td>'[% diagnostic.type %]'</td>
      </tr>
      <tr>
        <th>Pairs for this type</th>
        <td>[% diagnostic.pair_count %]</td>
      </tr>
      <tr>
        <th>Total pairs (all types)</th>
        <td>[% diagnostic.total_pairs %]</td>
      </tr>
      <tr>
        <th>Conflicts filtered</th>
        <td>[% diagnostic.conflicts_filtered %]</td>
      </tr>
    </table>
  </section>

  <section class="type-breakdown">
    <h2>Pairs by Type</h2>
    <table class="diagnostic-table">
      <thead>
        <tr>
          <th>Type</th>
          <th>Count</th>
        </tr>
      </thead>
      <tbody>
        [% FOREACH type_key IN diagnostic.pairs_by_type.keys.sort %]
        <tr>
          <td>[% type_key %]</td>
          <td>[% diagnostic.pairs_by_type.$type_key %]</td>
        </tr>
        [% END %]
      </tbody>
    </table>
  </section>

  <section class="available-types">
    <h2>Available Types</h2>
    <ul>
      [% FOREACH t IN diagnostic.available_types %]
      <li><a href="/Generals/diagnostic/[% t %]">[% t %]</a></li>
      [% END %]
    </ul>
  </section>

  <section class="sample-pairs">
    <h2>Sample Pairs (first 10)</h2>
    [% IF diagnostic.sample_pairs.size %]
    <table class="diagnostic-table">
      <thead>
        <tr>
          <th>Primary</th>
          <th>Secondary</th>
        </tr>
      </thead>
      <tbody>
        [% FOREACH pair IN diagnostic.sample_pairs %]
        <tr>
          <td>[% pair.primary %]</td>
          <td>[% pair.secondary %]</td>
        </tr>
        [% END %]
      </tbody>
    </table>
    [% ELSE %]
    <p>No pairs found for this type.</p>
    [% END %]
  </section>
</div>

<style>
  .diagnostic-container {
    padding: 20px;
    max-width: 800px;
    margin: 0 auto;
  }
  .diagnostic-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  .diagnostic-table th,
  .diagnostic-table td {
    border: 1px solid #ccc;
    padding: 8px;
    text-align: left;
  }
  .diagnostic-table th {
    background-color: #f5f5f5;
  }
  section {
    margin-bottom: 30px;
  }
</style>

[% END %]
