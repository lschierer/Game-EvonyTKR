[% WRAPPER layouts/default.tt %]

<div class="diagnostic-container">
  <h1>Conflicts Diagnostic: [% diagnostic.type %]</h1>

  <section class="stats">
    <h2>Statistics</h2>
    <table class="diagnostic-table">
      <tr>
        <th>Type</th>
        <td>'[% diagnostic.type %]'</td>
      </tr>
      <tr>
        <th>Generals of this type</th>
        <td>[% diagnostic.type_generals.size %]</td>
      </tr>
      <tr>
        <th>Conflicts for this type</th>
        <td>[% diagnostic.conflict_count %]</td>
      </tr>
      <tr>
        <th>Total conflicts (all types)</th>
        <td>[% diagnostic.total_conflicts %]</td>
      </tr>
    </table>
  </section>

  <section class="available-types">
    <h2>Available Types</h2>
    <ul>
      [% FOREACH t IN diagnostic.available_types %]
      <li><a href="/Generals/diagnostic/[% t %]">[% t %]</a></li>
      [% END %]
    </ul>
  </section>

  <section class="all-conflicts">
    <h2>All Conflicts ([% diagnostic.conflict_count %] total)</h2>
    [% IF diagnostic.all_conflicts.size %]
    <table class="diagnostic-table">
      <thead>
        <tr>
          <th>Primary</th>
          <th>Secondary (Conflicts With)</th>
        </tr>
      </thead>
      <tbody>
        [% FOREACH conflict IN diagnostic.all_conflicts %]
        <tr>
          <td>[% conflict.primary %]</td>
          <td>[% conflict.secondary %]</td>
        </tr>
        [% END %]
      </tbody>
    </table>
    [% ELSE %]
    <p>No conflicts found for this type.</p>
    [% END %]
  </section>
</div>

<style>
  .diagnostic-container {
    padding: 20px;
    max-width: 800px;
    margin: 0 auto;
  }
  .diagnostic-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  .diagnostic-table th,
  .diagnostic-table td {
    border: 1px solid #ccc;
    padding: 8px;
    text-align: left;
  }
  .diagnostic-table th {
    background-color: #f5f5f5;
  }
  section {
    margin-bottom: 30px;
  }
</style>

[% END %]
