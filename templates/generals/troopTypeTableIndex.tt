[% WRAPPER layouts/default.tt %]

<link rel="stylesheet" href="/css/collectionIndex.css" />

<article>
  <h1 class="spectrum-Heading spectrum-Heading--sizeXL">[% uiTarget %] Comparison Tables</h1>

  <p class="spectrum-Body spectrum-Body--sizeL">
    Select a buff activation type to compare [% uiTarget %] generals:
  </p>
</article>

<div class="link-grid">
  [% FOREACH route IN routes -%]
    <a
      href="/Generals/[% route.uiTarget %]/[% route.buffActivation %]"
      class="link-item spectrum-Button spectrum-Button--outline spectrum-Button--primary spectrum-Button--sizeM"
    >
      <span class="spectrum-Button-label">
        [% route.buffActivation %]
      </span>
    </a>
  [% END -%]
</div>

[% IF static_content -%]
  <hr role="separator" class="spectrum-Divider spectrum-Divider--sizeM" />
  <article>
    [% static_content %]
  </article>
[% END -%]

[% END %]
