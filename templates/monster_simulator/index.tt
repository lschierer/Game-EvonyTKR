[% WRAPPER layouts/default.tt %]

<article class="monster-simulator">
  <h1 class="spectrum-Heading spectrum-Heading--sizeXL">Monster Hunting Simulator</h1>

  <p class="spectrum-Body spectrum-Body--sizeM">
    Calculate damage output and expected wounds when attacking monsters.
    Based on the Derrick Defies Monster Simulator spreadsheet.
  </p>

  <form method="POST" action="[% linkBase %]/calculate" class="simulator-form">

    <!-- Monster Selection -->
    <section class="form-section">
      <h2 class="spectrum-Heading spectrum-Heading--sizeL">Monster Selection</h2>

      <div class="spectrum-Form-item">
        <label for="monster_name" class="spectrum-FieldLabel spectrum-FieldLabel--sizeM">Monster Name</label>
        <div class="spectrum-Textfield">
          <select id="monster_name" name="monster_name" class="spectrum-Picker-input" onchange="loadMonsterLevels(this.value)">
            <option value="">-- Select Monster --</option>
            [% FOREACH name IN monster_names %]
              <option value="[% name %]">[% name %]</option>
            [% END %]
          </select>
        </div>
      </div>

      <div class="spectrum-Form-item">
        <label for="monster_level" class="spectrum-FieldLabel spectrum-FieldLabel--sizeM">Monster Level</label>
        <div class="spectrum-Textfield">
          <select id="monster_level" name="monster_order" class="spectrum-Picker-input">
            <option value="">-- Select monster first --</option>
          </select>
        </div>
      </div>
    </section>

    <!-- Troop Configuration -->
    <section class="form-section">
      <h2 class="spectrum-Heading spectrum-Heading--sizeL">Troop Configuration</h2>

      <div class="form-row">
        <div class="spectrum-Form-item">
          <label for="march_type" class="spectrum-FieldLabel spectrum-FieldLabel--sizeM">March Type</label>
          <div class="spectrum-Textfield">
            <select id="march_type" name="march_type" class="spectrum-Picker-input">
              [% FOREACH mt IN march_types %]
                <option value="[% mt %]" [% IF defaults.march_type == mt %]selected[% END %]>
                  [% march_type_labels.$mt %]
                </option>
              [% END %]
            </select>
          </div>
        </div>

        <div class="spectrum-Form-item">
          <label for="tier" class="spectrum-FieldLabel spectrum-FieldLabel--sizeM">Tier</label>
          <div class="spectrum-Textfield">
            <select id="tier" name="tier" class="spectrum-Picker-input">
              [% FOREACH t IN tiers %]
                <option value="[% t %]" [% IF defaults.tier == t %]selected[% END %]>[% t %]</option>
              [% END %]
            </select>
          </div>
        </div>

        <div class="spectrum-Form-item">
          <label for="troop_type" class="spectrum-FieldLabel spectrum-FieldLabel--sizeM">Troop Type</label>
          <div class="spectrum-Textfield">
            <select id="troop_type" name="troop_type" class="spectrum-Picker-input">
              [% FOREACH tt IN troop_types %]
                <option value="[% tt %]" [% IF defaults.troop_type == tt %]selected[% END %]>
                  [% troop_type_labels.$tt %]
                </option>
              [% END %]
            </select>
          </div>
        </div>

        <div class="spectrum-Form-item">
          <label for="troop_count" class="spectrum-FieldLabel spectrum-FieldLabel--sizeM">Troop Count</label>
          <div class="spectrum-Textfield">
            <input type="number" id="troop_count" name="troop_count"
                   class="spectrum-Textfield-input"
                   value="[% defaults.troop_count %]" min="1" max="10000000">
          </div>
        </div>
      </div>
    </section>

    <!-- Buffs Section -->
    <section class="form-section">
      <h2 class="spectrum-Heading spectrum-Heading--sizeL">Your Buffs</h2>
      <p class="spectrum-Body spectrum-Body--sizeS">
        Click "Calculate" to enter buff values from each source. Unknown sources are automatically tracked.
      </p>

      <div class="buff-summary">
        <div class="buff-row">
          <label class="buff-label">Attack %</label>
          <input type="number" id="total_attack" name="total_attack" class="spectrum-Textfield-input buff-total" value="0" step="0.1" readonly>
          <button type="button" class="spectrum-Button spectrum-Button--sizeS spectrum-Button--secondary" onclick="openBuffCalculator('attack')">
            <span class="spectrum-Button-label">Calculate</span>
          </button>
          <span id="attack_unknown_count" class="unknown-badge"></span>
        </div>
        <div class="buff-row">
          <label class="buff-label">Defense %</label>
          <input type="number" id="total_defense" name="total_defense" class="spectrum-Textfield-input buff-total" value="0" step="0.1" readonly>
          <button type="button" class="spectrum-Button spectrum-Button--sizeS spectrum-Button--secondary" onclick="openBuffCalculator('defense')">
            <span class="spectrum-Button-label">Calculate</span>
          </button>
          <span id="defense_unknown_count" class="unknown-badge"></span>
        </div>
        <div class="buff-row">
          <label class="buff-label">HP %</label>
          <input type="number" id="total_hp" name="total_hp" class="spectrum-Textfield-input buff-total" value="0" step="0.1" readonly>
          <button type="button" class="spectrum-Button spectrum-Button--sizeS spectrum-Button--secondary" onclick="openBuffCalculator('hp')">
            <span class="spectrum-Button-label">Calculate</span>
          </button>
          <span id="hp_unknown_count" class="unknown-badge"></span>
        </div>
      </div>

      <!-- Hidden fields for buff breakdown by category -->
      <input type="hidden" name="attack_basic" id="attack_basic" value="0">
      <input type="hidden" name="attack_march" id="attack_march" value="0">
      <input type="hidden" name="attack_monster" id="attack_monster" value="0">
      <input type="hidden" name="attack_misc" id="attack_misc" value="0">
      <input type="hidden" name="attack_rally" id="attack_rally" value="0">
      <input type="hidden" name="defense_basic" id="defense_basic" value="0">
      <input type="hidden" name="defense_march" id="defense_march" value="0">
      <input type="hidden" name="defense_monster" id="defense_monster" value="0">
      <input type="hidden" name="defense_misc" id="defense_misc" value="0">
      <input type="hidden" name="defense_rally" id="defense_rally" value="0">
      <input type="hidden" name="hp_basic" id="hp_basic" value="0">
      <input type="hidden" name="hp_march" id="hp_march" value="0">
      <input type="hidden" name="hp_monster" id="hp_monster" value="0">
      <input type="hidden" name="hp_misc" id="hp_misc" value="0">
      <input type="hidden" name="hp_rally" id="hp_rally" value="0">
    </section>

    <!-- Debuffs Section -->
    <section class="form-section">
      <h2 class="spectrum-Heading spectrum-Heading--sizeL">Debuffs</h2>

      <div class="form-row">
        <div class="spectrum-Form-item">
          <label class="spectrum-FieldLabel spectrum-FieldLabel--sizeM">Monster Attack Debuff %</label>
          <div class="spectrum-Textfield">
            <input type="number" name="monster_attack_debuff" class="spectrum-Textfield-input" value="0" step="0.1">
          </div>
          <p class="spectrum-Body spectrum-Body--sizeXS">Reduces monster's attack</p>
        </div>

        <div class="spectrum-Form-item">
          <label class="spectrum-FieldLabel spectrum-FieldLabel--sizeM">Monster Defense Debuff %</label>
          <div class="spectrum-Textfield">
            <input type="number" name="monster_defense_debuff" class="spectrum-Textfield-input" value="0" step="0.1">
          </div>
          <p class="spectrum-Body spectrum-Body--sizeXS">Reduces monster's defense</p>
        </div>
      </div>

      <div class="form-row">
        <div class="spectrum-Form-item">
          <label class="spectrum-FieldLabel spectrum-FieldLabel--sizeM">Troop Attack Debuff %</label>
          <div class="spectrum-Textfield">
            <input type="number" name="troop_attack_debuff" class="spectrum-Textfield-input" value="0" step="0.1">
          </div>
          <p class="spectrum-Body spectrum-Body--sizeXS">Enemy reduces your attack</p>
        </div>

        <div class="spectrum-Form-item">
          <label class="spectrum-FieldLabel spectrum-FieldLabel--sizeM">Troop Defense Debuff %</label>
          <div class="spectrum-Textfield">
            <input type="number" name="troop_defense_debuff" class="spectrum-Textfield-input" value="0" step="0.1">
          </div>
          <p class="spectrum-Body spectrum-Body--sizeXS">Enemy reduces your defense</p>
        </div>

        <div class="spectrum-Form-item">
          <label class="spectrum-FieldLabel spectrum-FieldLabel--sizeM">Troop HP Debuff %</label>
          <div class="spectrum-Textfield">
            <input type="number" name="troop_hp_debuff" class="spectrum-Textfield-input" value="0" step="0.1">
          </div>
          <p class="spectrum-Body spectrum-Body--sizeXS">Enemy reduces your HP</p>
        </div>
      </div>
    </section>

    <!-- Submit -->
    <section class="form-section">
      <button type="submit" class="spectrum-Button spectrum-Button--fill spectrum-Button--accent spectrum-Button--sizeL">
        <span class="spectrum-Button-label">Run Simulation</span>
      </button>
    </section>

  </form>
</article>

<!-- Buff Calculator Modal -->
<div id="buffCalculatorModal" class="modal-overlay" style="display: none;">
  <div class="modal-content">
    <div class="modal-header">
      <h3 class="spectrum-Heading spectrum-Heading--sizeM" id="modalTitle">Calculate Attack Buffs</h3>
      <button type="button" class="modal-close" onclick="closeBuffCalculator()">&times;</button>
    </div>
    <div class="modal-body">
      <p class="spectrum-Body spectrum-Body--sizeS" style="margin-bottom: 1rem;">
        Enter known buff values from each source. Mark sources as "Unknown" if you haven't looked them up yet.
      </p>

      <div class="buff-sources">
        <!-- Research (Academy & Military Academy) -->
        <div class="source-group" data-source="research">
          <h4>Research</h4>
          <input type="number" class="buff-source" data-source="research" value="0" step="0.1" placeholder="0">
          <p class="help-text">Academy + Military Academy trees</p>
          <label class="source-unknown">
            <input type="checkbox" class="unknown-checkbox" data-source="research">
            Unknown
          </label>
        </div>

        <!-- Art Treasures -->
        <div class="source-group" data-source="art_treasures">
          <h4>Art Treasures</h4>
          <input type="number" class="buff-source" data-source="art_treasures" value="0" step="0.1" placeholder="0">
          <p class="help-text">16 treasures, levels 0-10 each</p>
          <label class="source-unknown">
            <input type="checkbox" class="unknown-checkbox" data-source="art_treasures">
            Unknown
          </label>
        </div>

        <!-- Civilization Cards -->
        <div class="source-group" data-source="civ_cards">
          <h4>Civilization Cards</h4>
          <input type="number" class="buff-source" data-source="civ_cards" value="0" step="0.1" placeholder="0">
          <p class="help-text">4 card sets, passive buffs</p>
          <label class="source-unknown">
            <input type="checkbox" class="unknown-checkbox" data-source="civ_cards">
            Unknown
          </label>
        </div>

        <!-- Civilization Equipment -->
        <div class="source-group" data-source="civ_equipment">
          <h4>Civ Equipment</h4>
          <input type="number" class="buff-source" data-source="civ_equipment" value="0" step="0.1" placeholder="0">
          <p class="help-text">16 sets, active when equipped</p>
          <label class="source-unknown">
            <input type="checkbox" class="unknown-checkbox" data-source="civ_equipment">
            Unknown
          </label>
        </div>

        <!-- Civilization Treasure -->
        <div class="source-group" data-source="civ_treasure">
          <h4>Civ Treasure</h4>
          <input type="number" class="buff-source" data-source="civ_treasure" value="0" step="0.1" placeholder="0">
          <p class="help-text">Levels 0-15, active/passive buffs</p>
          <label class="source-unknown">
            <input type="checkbox" class="unknown-checkbox" data-source="civ_treasure">
            Unknown
          </label>
        </div>

        <!-- Senate Seats -->
        <div class="source-group" data-source="senate">
          <h4>Senate Seats</h4>
          <input type="number" class="buff-source" data-source="senate" value="0" step="0.1" placeholder="0">
          <p class="help-text">6 titles, passive buffs</p>
          <label class="source-unknown">
            <input type="checkbox" class="unknown-checkbox" data-source="senate">
            Unknown
          </label>
        </div>

        <!-- Building Buffs -->
        <div class="source-group" data-source="buildings">
          <h4>Buildings</h4>
          <input type="number" class="buff-source" data-source="buildings" value="0" step="0.1" placeholder="0">
          <p class="help-text">Level 36+ buildings + officers</p>
          <label class="source-unknown">
            <input type="checkbox" class="unknown-checkbox" data-source="buildings">
            Unknown
          </label>
        </div>

        <!-- Ideal Land -->
        <div class="source-group" data-source="ideal_land">
          <h4>Ideal Land</h4>
          <input type="number" class="buff-source" data-source="ideal_land" value="0" step="0.1" placeholder="0">
          <p class="help-text">Decorations, passive buffs</p>
          <label class="source-unknown">
            <input type="checkbox" class="unknown-checkbox" data-source="ideal_land">
            Unknown
          </label>
        </div>

        <!-- Coronation Fountain -->
        <div class="source-group" data-source="fountain">
          <h4>Coronation Fountain</h4>
          <input type="number" class="buff-source" data-source="fountain" value="0" step="0.1" placeholder="0">
          <p class="help-text">6 slots + cumulative bonuses</p>
          <label class="source-unknown">
            <input type="checkbox" class="unknown-checkbox" data-source="fountain">
            Unknown
          </label>
        </div>

        <!-- Wisdom Dome -->
        <div class="source-group" data-source="wisdom_dome">
          <h4>Wisdom Dome</h4>
          <input type="number" class="buff-source" data-source="wisdom_dome" value="0" step="0.1" placeholder="0">
          <p class="help-text">Books + Blazons, passive</p>
          <label class="source-unknown">
            <input type="checkbox" class="unknown-checkbox" data-source="wisdom_dome">
            Unknown
          </label>
        </div>

        <!-- Duty Generals -->
        <div class="source-group" data-source="duty_generals">
          <h4>Duty Generals</h4>
          <input type="number" class="buff-source" data-source="duty_generals" value="0" step="0.1" placeholder="0">
          <p class="help-text">Officers assigned to buildings</p>
          <label class="source-unknown">
            <input type="checkbox" class="unknown-checkbox" data-source="duty_generals">
            Unknown
          </label>
        </div>

        <!-- March General -->
        <div class="source-group" data-source="march_general">
          <h4>March General</h4>
          <input type="number" class="buff-source" data-source="march_general" value="0" step="0.1" placeholder="0">
          <p class="help-text">Leading general's active buffs</p>
          <label class="source-unknown">
            <input type="checkbox" class="unknown-checkbox" data-source="march_general">
            Unknown
          </label>
        </div>

        <!-- Assistant General -->
        <div class="source-group" data-source="assistant_general">
          <h4>Assistant General</h4>
          <input type="number" class="buff-source" data-source="assistant_general" value="0" step="0.1" placeholder="0">
          <p class="help-text">Paired general's buffs</p>
          <label class="source-unknown">
            <input type="checkbox" class="unknown-checkbox" data-source="assistant_general">
            Unknown
          </label>
        </div>

        <!-- Spiritual Beast -->
        <div class="source-group" data-source="spiritual_beast">
          <h4>Spiritual Beast</h4>
          <input type="number" class="buff-source" data-source="spiritual_beast" value="0" step="0.1" placeholder="0">
          <p class="help-text">Beast buffs on march</p>
          <label class="source-unknown">
            <input type="checkbox" class="unknown-checkbox" data-source="spiritual_beast">
            Unknown
          </label>
        </div>

        <!-- Other/Misc -->
        <div class="source-group" data-source="other">
          <h4>Other Sources</h4>
          <input type="number" class="buff-source" data-source="other" value="0" step="0.1" placeholder="0">
          <p class="help-text">VIP, Alliance, Events, etc.</p>
          <label class="source-unknown">
            <input type="checkbox" class="unknown-checkbox" data-source="other">
            Unknown
          </label>
        </div>
      </div>

      <div class="buff-total-display">
        <strong>Total:</strong> <span id="modal-total" class="modal-total-value">0</span>%
        <div class="confidence-indicator" id="confidence-indicator"></div>
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="spectrum-Button spectrum-Button--secondary spectrum-Button--sizeM" onclick="closeBuffCalculator()">
        <span class="spectrum-Button-label">Cancel</span>
      </button>
      <button type="button" class="spectrum-Button spectrum-Button--accent spectrum-Button--sizeM" onclick="applyBuffTotal()">
        <span class="spectrum-Button-label">Apply</span>
      </button>
    </div>
  </div>
</div>

<script>
let currentBuffType = null;
const buffData = {
  attack: { values: {}, unknowns: {} },
  defense: { values: {}, unknowns: {} },
  hp: { values: {}, unknowns: {} }
};

const sourceCategories = {
  // Passive (always-on) sources -> basic category
  research: 'basic',
  art_treasures: 'basic',
  civ_cards: 'basic',
  senate: 'basic',
  buildings: 'basic',
  ideal_land: 'basic',
  fountain: 'basic',
  wisdom_dome: 'basic',
  duty_generals: 'basic',

  // Active sources tied to the march -> march category
  civ_equipment: 'march',
  civ_treasure: 'march',
  march_general: 'march',
  assistant_general: 'march',
  spiritual_beast: 'march',

  // Other/misc
  other: 'misc'
};

async function loadMonsterLevels(monsterName) {
  const levelSelect = document.getElementById('monster_level');
  levelSelect.innerHTML = '<option value="">Loading...</option>';

  if (!monsterName) {
    levelSelect.innerHTML = '<option value="">-- Select monster first --</option>';
    return;
  }

  try {
    const response = await fetch(`[% linkBase %]/api/monster-levels/${encodeURIComponent(monsterName)}`);
    const levels = await response.json();

    levelSelect.innerHTML = '';
    levels.forEach(item => {
      const option = document.createElement('option');
      option.value = item.order;
      option.textContent = `Level ${item.level}`;
      levelSelect.appendChild(option);
    });
  } catch (err) {
    levelSelect.innerHTML = '<option value="">Error loading levels</option>';
  }
}

function openBuffCalculator(buffType) {
  currentBuffType = buffType;
  const modal = document.getElementById('buffCalculatorModal');
  const title = document.getElementById('modalTitle');

  title.textContent = `Calculate ${buffType.charAt(0).toUpperCase() + buffType.slice(1)} Buffs`;

  // Load saved values and unknown states
  const sources = document.querySelectorAll('.buff-source');
  const unknowns = document.querySelectorAll('.unknown-checkbox');

  sources.forEach(input => {
    const source = input.dataset.source;
    input.value = buffData[buffType].values[source] || 0;
    // Disable input if unknown
    const isUnknown = buffData[buffType].unknowns[source] || false;
    input.disabled = isUnknown;
    input.closest('.source-group').classList.toggle('is-unknown', isUnknown);
  });

  unknowns.forEach(checkbox => {
    const source = checkbox.dataset.source;
    checkbox.checked = buffData[buffType].unknowns[source] || false;
  });

  updateModalTotal();
  modal.style.display = 'flex';
}

function closeBuffCalculator() {
  document.getElementById('buffCalculatorModal').style.display = 'none';
}

function updateModalTotal() {
  const sources = document.querySelectorAll('.buff-source');
  let total = 0;
  let filledCount = 0;
  let unknownCount = 0;
  let totalCount = sources.length;

  sources.forEach(input => {
    const source = input.dataset.source;
    const val = parseFloat(input.value) || 0;
    const isUnknown = document.querySelector(`.unknown-checkbox[data-source="${source}"]`).checked;

    if (isUnknown) {
      unknownCount++;
    } else {
      total += val;
      if (val > 0) filledCount++;
    }
  });

  document.getElementById('modal-total').textContent = total.toFixed(1);

  // Calculate confidence based on known vs unknown sources
  const knownCount = totalCount - unknownCount;
  const confidence = document.getElementById('confidence-indicator');

  if (unknownCount === totalCount) {
    confidence.textContent = 'All sources unknown - results will be minimum estimates';
    confidence.className = 'confidence-indicator confidence-very-low';
  } else if (unknownCount > totalCount * 0.7) {
    confidence.textContent = `${unknownCount} unknown sources - results significantly underestimated`;
    confidence.className = 'confidence-indicator confidence-low';
  } else if (unknownCount > totalCount * 0.5) {
    confidence.textContent = `${unknownCount} unknown sources - results moderately underestimated`;
    confidence.className = 'confidence-indicator confidence-medium-low';
  } else if (unknownCount > totalCount * 0.3) {
    confidence.textContent = `${unknownCount} unknown sources - results somewhat underestimated`;
    confidence.className = 'confidence-indicator confidence-medium';
  } else if (unknownCount > 0) {
    confidence.textContent = `${unknownCount} unknown source(s) - results slightly underestimated`;
    confidence.className = 'confidence-indicator confidence-high';
  } else {
    confidence.textContent = 'All buff sources accounted for';
    confidence.className = 'confidence-indicator confidence-complete';
  }
}

function applyBuffTotal() {
  const sources = document.querySelectorAll('.buff-source');
  const unknowns = document.querySelectorAll('.unknown-checkbox');

  // Initialize category totals
  const categoryTotals = { basic: 0, march: 0, monster: 0, misc: 0, rally: 0 };
  let unknownCount = 0;

  // Save values and calculate totals by category
  sources.forEach(input => {
    const source = input.dataset.source;
    const val = parseFloat(input.value) || 0;
    const isUnknown = document.querySelector(`.unknown-checkbox[data-source="${source}"]`).checked;

    buffData[currentBuffType].values[source] = val;
    buffData[currentBuffType].unknowns[source] = isUnknown;

    if (isUnknown) {
      unknownCount++;
    } else {
      const category = sourceCategories[source] || 'misc';
      categoryTotals[category] += val;
    }
  });

  // Calculate total
  const total = categoryTotals.basic + categoryTotals.march + categoryTotals.monster + categoryTotals.misc + categoryTotals.rally;

  // Update main form display
  document.getElementById(`total_${currentBuffType}`).value = total.toFixed(1);

  // Update hidden form fields with category breakdowns
  document.getElementById(`${currentBuffType}_basic`).value = categoryTotals.basic;
  document.getElementById(`${currentBuffType}_march`).value = categoryTotals.march;
  document.getElementById(`${currentBuffType}_monster`).value = categoryTotals.monster;
  document.getElementById(`${currentBuffType}_misc`).value = categoryTotals.misc;
  document.getElementById(`${currentBuffType}_rally`).value = categoryTotals.rally;

  // Update unknown badge
  const badge = document.getElementById(`${currentBuffType}_unknown_count`);
  if (unknownCount > 0) {
    badge.textContent = `${unknownCount} unknown`;
    badge.style.display = 'inline-block';
  } else {
    badge.style.display = 'none';
  }

  closeBuffCalculator();
}

// Handle unknown checkbox changes
document.addEventListener('DOMContentLoaded', () => {
  document.addEventListener('change', (e) => {
    if (e.target.classList.contains('unknown-checkbox')) {
      const source = e.target.dataset.source;
      const isUnknown = e.target.checked;
      const input = document.querySelector(`.buff-source[data-source="${source}"]`);
      const group = e.target.closest('.source-group');

      input.disabled = isUnknown;
      group.classList.toggle('is-unknown', isUnknown);

      if (isUnknown) {
        input.value = 0;
      }

      updateModalTotal();
    }
  });

  document.addEventListener('input', (e) => {
    if (e.target.classList.contains('buff-source')) {
      updateModalTotal();
    }
  });
});
</script>

[% END %]
