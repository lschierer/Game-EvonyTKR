#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Volumes/External/luke/src/Game-EvonyTKR/node_modules/.pnpm/git-raw-commits@4.0.0/node_modules/git-raw-commits/node_modules:/Volumes/External/luke/src/Game-EvonyTKR/node_modules/.pnpm/git-raw-commits@4.0.0/node_modules:/Volumes/External/luke/src/Game-EvonyTKR/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Volumes/External/luke/src/Game-EvonyTKR/node_modules/.pnpm/git-raw-commits@4.0.0/node_modules/git-raw-commits/node_modules:/Volumes/External/luke/src/Game-EvonyTKR/node_modules/.pnpm/git-raw-commits@4.0.0/node_modules:/Volumes/External/luke/src/Game-EvonyTKR/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../git-raw-commits/cli.mjs" "$@"
else
  exec node  "$basedir/../git-raw-commits/cli.mjs" "$@"
fi
