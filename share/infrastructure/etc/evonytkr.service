[Unit]
Description=Evony TKR Tips Website
After=network.target

[Service]
Type=simple
User=appuser
Group=www-data
WorkingDirectory=/opt/prefix/app
Environment="PATH=/opt/prefix/.local/bin:/opt/prefix/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin"
PIDFile=/opt/prefix/var/run/Game-EvonyTKR.pid
ExecStart=/opt/prefix/bin/appperl bin/server2.pl --mode test
ExecReload=/bin/kill -HUP $MAINPID
TimeoutStartSec=900
KillMode=mixed
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
