<div class="builtinbook-details">
  <% if( $item ) { %>
    <% require Scalar::Util; %>
    <% if( Scalar::Util::reftype($item) eq 'HASH' && Scalar::Util::blessed($item) =~ /Game::EvonyTKR::Model::Book/) { %>
      <h3><%= $item->name %></h3>
      <p class="description">
        <%= $item->text %>
      </p>
      <ul>
        <% foreach my $buff  (@{ $item->buff }) { %>
          <li>
            <dl>
              <dt>Attribute: </dt>
              <dd><%= $buff->attribute %>
              <% if( defined($buff->targetedType)) { %>
                <dt>Troop Type: </dt>
                <% if( Scalar::Util::reftype($buff->targetedType) && Scalar::Util::reftype($buff->targetedType) eq 'ARRAY') { %>
                  <% foreach my $tt ($buff->targetedType->@*) { %>
                    <dd><%== $tt %></dd>
                  <% } %>
                <% } elsif ( length $buff->targetedType  > 0 ) { %>
                  <dd><%= $buff->targetedType %></dd>
                <% } else { %>
                  <!-- <%== $buff->targetedType %> -->
                <% } %>
              <% } %>
              <% if ( scalar $buff->conditions()  ) { %>
                <dt>Condition(s): </dt>
                <% foreach my $condition ($buff->conditions()->@* ) { %>
                  <dd><%= $condition %></dd>
                <% } %>
              <% } %>
              <dt>Value: </dt>
              <dd><%= $buff->value->number %><%= $buff->value->unit eq 'percentage' ? '%' : '' %></dd>
            </dl>
          </li>
        <% } %>
      </ul>
    <% } else { %>
      <%= Scalar::Util::reftype($item) %>
      <%= Scalar::Util::blessed($item) %>
    <% } %>
  <% } %>
</div>
<% require Data::Printer; %>
<!-- <%== Data::Printer::np($item) %> -->
