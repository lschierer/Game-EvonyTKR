{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2025",
    "verbatimModuleSyntax": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": true,
    "isolatedModules": false,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node",
      "./types/myGlobals.d.ts"
    ],
    "noEmit": true,
    "composite": true,
    "rootDir": ".",
    "outDir": "./share/public/types",
    "declarationDir": "./share/public/types"
  },
  "exclude": ["**/node_modules/**", "**/cdk.out/**"],
  "include": [
    "./lib/**/*.ts",
    "./scripts/*.ts",
    "./infrastructure/**/*.ts",
    "./types/**/*.ts"
  ],
  // This project is composite, so every file in its program must be matched by the
  // include patterns above - and scripts/ imports two files out of the framework
  // (lib/Infrastructure/index.ts and scripts/build-css.ts). Without the reference
  // those imports drag framework SOURCE into this program, which is both outside
  // rootDir (TS6059) and unlisted (TS6307). With it, TypeScript redirects them to
  // the framework's built declarations in its dist/ instead, so they are no longer
  // inputs here. tsc on the command line missed this because tsconfig.build.json
  // does not include scripts/; the editors use THIS file and so they did not.
  "references": [
    {"path": "../PAGI-WebServer"}
  ]
}
